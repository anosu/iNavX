# 对外访问后台的完整来源（协议、域名、端口），HTTPS 反向代理使用 https://nav.example.com。
APP_ORIGIN=http://localhost:3000
PORT=3000
# 公共前台分离部署时填写它的来源；公开读取与匿名申请允许此跨域来源。
PUBLIC_ORIGIN=
# 本地 Go 运行可配置，Compose 使用独立命名卷。
DATA_DIR=./data
BACKUP_DIR=./backups
# 可选验证码：同时填写两个值后启用 Cloudflare Turnstile；后台可以关闭收录入口。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 默认不信任客户端 IP 头。只有指定代理的连接地址才读取其覆盖的 X-Real-IP。
# 示例：TRUSTED_PROXY_IPS=172.18.0.2；代理必须覆盖请求头，容器仅允许代理访问。
TRUSTED_PROXY_IPS=
