{
	"name": "inav",
	"private": true,
	"version": "0.9.0",
	"type": "module",
	"packageManager": "bun@1.3.12",
	"engines": {
		"node": ">=22.18.0"
	},
	"trustedDependencies": [
		"better-sqlite3"
	],
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build && tsc -p tsconfig.server.json",
		"build:server": "tsc -p tsconfig.server.json",
		"dev:server": "node --env-file-if-exists=.env --import tsx --watch server/dev.ts",
		"start": "node --env-file-if-exists=.env dist-server/server/entry.js",
		"test": "node --import tsx --test server/app.test.ts server/migrations.test.ts shared/catalog.test.ts shared/admin-api.test.ts shared/import.test.ts shared/resources.test.ts",
		"db:generate": "drizzle-kit generate",
		"lint": "biome check --error-on-warnings .",
		"lint:fix": "biome check --write .",
		"preview": "vite preview",
		"release": "bash scripts/release.sh",
		"release:minor": "bash scripts/release.sh minor",
		"release:major": "bash scripts/release.sh major"
	},
	"dependencies": {
		"@hono/node-server": "2.1.3",
		"better-sqlite3": "13.0.3",
		"drizzle-orm": "0.45.3",
		"hono": "4.13.13",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-router": "^7.18.4",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@tailwindcss/vite": "^4.3.3",
		"tailwindcss": "^4.3.3",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "^24.19.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^5.2.0",
		"drizzle-kit": "0.31.11",
		"tsx": "4.23.15",
		"typescript": "~5.9.3",
		"vite": "^7.3.6"
	}
}
