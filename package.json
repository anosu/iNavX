{
	"name": "inav",
	"private": true,
	"version": "0.9.0",
	"type": "module",
	"packageManager": "bun@1.3.12",
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build && bun run build:runtime",
		"build:runtime": "bun scripts/export-runtime.ts",
		"build:server": "go build -trimpath -o bin/inav ./backend",
		"dev:server": "bun run build:runtime && go run ./backend",
		"start": "./bin/inav serve",
		"test": "node --import tsx --test shared/catalog.test.ts shared/admin-api.test.ts shared/import.test.ts shared/resources.test.ts",
		"test:server": "go test ./backend",
		"lint": "biome check --error-on-warnings .",
		"lint:fix": "biome check --write .",
		"preview": "vite preview",
		"release": "bash scripts/release.sh",
		"release:minor": "bash scripts/release.sh minor",
		"release:major": "bash scripts/release.sh major"
	},
	"dependencies": {
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-router": "^7.18.4",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@tailwindcss/vite": "^4.3.3",
		"tailwindcss": "^4.3.3",
		"@types/node": "^24.19.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^5.2.0",
		"tsx": "4.23.15",
		"typescript": "~5.9.3",
		"vite": "^7.3.6"
	}
}
