{
	"name": "inav",
	"private": true,
	"version": "0.9.0",
	"type": "module",
	"packageManager": "bun@1.3.12",
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build && bun run build:runtime",
		"build:runtime": "bun scripts/export-runtime.ts",
		"build:server": "bun scripts/backend.ts build",
		"dev:server": "bun scripts/backend.ts dev",
		"start": "bun scripts/backend.ts start",
		"test": "node --import tsx --test shared/catalog.test.ts shared/admin-api.test.ts shared/import.test.ts shared/resources.test.ts",
		"test:server": "bun scripts/backend.ts test",
		"test:ui": "bun test ./tests/ui/interactions.test.tsx",
		"test:e2e": "playwright test",
		"format": "bun scripts/quality.ts format",
		"format:check": "bun scripts/quality.ts format:check",
		"lint": "bun scripts/quality.ts lint",
		"lint:fix": "bun scripts/quality.ts lint:fix",
		"lint:frontend": "biome check --error-on-warnings .",
		"lint:go": "bun scripts/quality.ts lint:go",
		"lint:shell": "bun scripts/quality.ts lint:shell",
		"typecheck": "tsc -b",
		"check": "bun run lint && bun run typecheck && bun run test && bun run test:ui && bun run test:server",
		"check:full": "bun run check && bun run build && bun run build:server && bun run test:e2e && bash tests/deploy.test.sh",
		"preview": "vite preview",
		"release": "bash scripts/release.sh",
		"release:minor": "bash scripts/release.sh minor",
		"release:major": "bash scripts/release.sh major"
	},
	"dependencies": {
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-router": "^7.18.4",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@playwright/test": "^1.63.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^5.2.0",
		"happy-dom": "^20.14.5",
		"tailwindcss": "^4.3.3",
		"tsx": "4.23.15",
		"typescript": "~5.9.3",
		"vite": "^7.3.6"
	}
}
